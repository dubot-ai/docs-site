{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Dubot Docs",
  "description": "Product and integration documentation for Dubot",
  "colors": {
    "primary": "#0D1341",
    "light": "#F4BEAE",
    "dark": "#EA6242"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans",
      "weight": 700
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "seo": {
    "metatags": {
      "canonical": "https://dubot.mintlify.site"
    }
  },
  "redirects": [
    {
      "source": "/start/availability",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/operate/activity",
      "destination": "/guides/understand-analytics",
      "permanent": true
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Security",
        "href": "https://www.dubot.ai/security"
      },
      {
        "label": "Support",
        "href": "https://www.dubot.ai/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Dubot",
      "href": "https://app.dubot.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "start/first-value"]
          },
          {
            "group": "Understand Dubot",
            "pages": [
              "concepts/how-dubot-works",
              "surfaces/overview",
              "concepts/object-model",
              "concepts/acquisition"
            ]
          },
          {
            "group": "Build",
            "pages": [
              {
                "group": "Knowledge",
                "root": "product/knowledge",
                "expanded": false,
                "pages": [
                  "guides/add-knowledge"
                ]
              },
              {
                "group": "Brand",
                "root": "product/brand",
                "expanded": false,
                "pages": [
                  "guides/set-up-your-brand"
                ]
              },
              {
                "group": "Actions and capabilities",
                "root": "product/capabilities-actions",
                "expanded": false,
                "pages": [
                  "guides/create-action",
                  "guides/add-actions-with-extension",
                  "guides/create-capability"
                ]
              },
              {
                "group": "Resource Center",
                "root": "product/resource-center",
                "expanded": false,
                "pages": [
                  "guides/configure-resource-center"
                ]
              },
              {
                "group": "Wizards",
                "root": "product/wizards",
                "expanded": false,
                "pages": [
                  "guides/build-and-publish-wizard"
                ]
              },
              {
                "group": "Guidance",
                "root": "product/guidance",
                "expanded": false,
                "pages": [
                  "guides/enable-guidance",
                  "guides/review-guidance-run"
                ]
              }
            ]
          },
          {
            "group": "Test and launch",
            "pages": [
              "guides/preview-with-browser-extension",
              "operate/publishing",
              "operate/recovery"
            ]
          },
          {
            "group": "Measure and improve",
            "pages": ["guides/understand-analytics"]
          },
          {
            "group": "Plan and govern",
            "pages": ["trust/governance-security", "pilots/pilot-guide"]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Start integrating",
            "pages": ["integrations/overview", "sdk/quickstart", "sdk/troubleshooting"]
          },
          {
            "group": "Browser SDK",
            "pages": [
              "sdk/identity-context",
              "sdk/actions",
              "sdk/surfaces"
            ]
          },
          {
            "group": "AI clients and MCP",
            "pages": ["integrations/mcp"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Browser SDK",
            "pages": ["reference/sdk-api"]
          },
          {
            "group": "Product",
            "pages": ["reference/glossary"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {},
    "links": [
      {
        "header": "Dubot",
        "items": [
          {
            "label": "Main site",
            "href": "https://www.dubot.ai"
          },
          {
            "label": "Security",
            "href": "https://www.dubot.ai/security"
          },
          {
            "label": "Support",
            "href": "https://www.dubot.ai/support"
          }
        ]
      },
      {
        "header": "Get started",
        "items": [
          {
            "label": "Open Dubot",
            "href": "https://app.dubot.ai"
          },
          {
            "label": "Talk to us",
            "href": "https://www.dubot.ai/demo"
          }
        ]
      }
    ]
  }
}
