{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Dubot Docs",
  "description": "Product and integration documentation for Dubot",
  "colors": {
    "primary": "#0D1341",
    "light": "#F4BEAE",
    "dark": "#EA6242"
  },
  "fonts": {
    "heading": {
      "family": "Schibsted Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Schibsted Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "seo": {
    "metatags": {
      "canonical": "https://dubot.mintlify.site"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "start/availability"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-dubot-works",
              "concepts/object-model",
              "concepts/acquisition"
            ]
          }
        ]
      },
      {
        "tab": "Build",
        "icon": "blocks",
        "groups": [
          {
            "group": "Product",
            "pages": [
              "surfaces/overview",
              "product/wizards",
              "product/guidance",
              "product/resource-center",
              "product/capabilities-actions",
              "product/knowledge",
              "product/brand"
            ]
          }
        ]
      },
      {
        "tab": "Integrate",
        "icon": "plug",
        "groups": [
          {
            "group": "Browser SDK",
            "pages": [
              "sdk/quickstart",
              "sdk/identity-context",
              "sdk/actions",
              "sdk/surfaces"
            ]
          },
          {
            "group": "MCP",
            "pages": ["integrations/mcp"]
          }
        ]
      },
      {
        "tab": "Operate",
        "icon": "activity",
        "groups": [
          {
            "group": "Release and learn",
            "pages": ["operate/publishing", "operate/activity"]
          },
          {
            "group": "Trust",
            "pages": ["trust/governance-security"]
          }
        ]
      },
      {
        "tab": "Evaluate",
        "icon": "flag",
        "groups": [
          {
            "group": "Plan an evaluation",
            "pages": ["integrations/overview", "pilots/pilot-guide"]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "book-open",
        "groups": [
          {
            "group": "SDK",
            "pages": ["reference/sdk-api"]
          },
          {
            "group": "Product",
            "pages": ["reference/glossary"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
