{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Dubot Docs",
  "description": "Product and integration documentation for Dubot",
  "colors": {
    "primary": "#0D1341",
    "light": "#F4BEAE",
    "dark": "#EA6242"
  },
  "fonts": {
    "heading": {
      "family": "Schibsted Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Schibsted Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "seo": {
    "metatags": {
      "canonical": "https://dubot.mintlify.site"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "start/availability"]
          },
          {
            "group": "Understand Dubot",
            "pages": [
              "concepts/how-dubot-works",
              "concepts/object-model",
              "concepts/acquisition"
            ]
          },
          {
            "group": "Experiences",
            "pages": [
              "surfaces/overview",
              "product/resource-center",
              "product/wizards",
              "product/guidance"
            ]
          },
          {
            "group": "Configure",
            "pages": [
              "product/capabilities-actions",
              "product/knowledge",
              "product/brand"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "operate/publishing",
              "operate/activity",
              "trust/governance-security"
            ]
          },
          {
            "group": "Evaluate",
            "pages": ["pilots/pilot-guide"]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Start integrating",
            "pages": ["integrations/overview", "sdk/quickstart"]
          },
          {
            "group": "Browser SDK",
            "pages": [
              "sdk/identity-context",
              "sdk/actions",
              "sdk/surfaces"
            ]
          },
          {
            "group": "Agent integrations",
            "pages": ["integrations/mcp"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Browser SDK",
            "pages": ["reference/sdk-api"]
          },
          {
            "group": "Product",
            "pages": ["reference/glossary"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
